# ---------------------------------------------------------------------------
# CRA Annex I #4 (minimise attack surface) / #2 (no known CVEs at shipment).
#
# The Luckfox BSP defconfig is written for camera/IPC and MicroPython demo
# boards: it selects a desktop media stack (mpv, ffmpeg, SDL2, pulseaudio,
# jack2, sox, madplay, ALSA and Bluetooth tooling), a python module set and a
# handful of network utilities. Neither the SATISense Industrial Edge Platform
# nor the T1S Media Gateway uses any of it — verified against both product
# trees: no dbus/bluetoothd/pulseaudio reference in any runtime code or init
# script, no PIL import, and no invocation of ffmpeg/mpv/rsync/7z/madplay.
#
# The 2026-08-09 CVE gate run (./build.sh cve) attributed 73 of 100 blocking
# findings to exactly these packages, including the image's only CISA-KEV entry
# (CVE-2025-27363, freetype, reached via harfbuzz/libass/pillow/sdl2_ttf) and
# its highest-scoring one (CVE-2025-54349, iperf3, CVSS 10.0). Each removal
# below is annotated with why the package was present.
#
# Same root cause as the telnetd/adbd/Samba removal of 2026-08-08, one layer
# down: inherited defaults rather than product requirements.
# ---------------------------------------------------------------------------

# Audio/video stack — removed. mpv is the root of most of it: it selects
# ffmpeg (23 findings), sdl2 and libass -> harfbuzz -> freetype (the KEV).
# Nothing in either product plays or records media; the RV1106 media pipeline
# used by the camera products is rockit/rkmedia, not this.
# BR2_PACKAGE_ALSA_UTILS is not set
# BR2_PACKAGE_BLUEZ_ALSA is not set
# BR2_PACKAGE_JACK2 is not set
# BR2_PACKAGE_MADPLAY is not set
# BR2_PACKAGE_MPV is not set
# BR2_PACKAGE_PULSEAUDIO is not set
# BR2_PACKAGE_SOX is not set
# BR2_PACKAGE_LIBAO is not set
# BR2_PACKAGE_PORTAUDIO is not set
# BR2_PACKAGE_SDL2_GFX is not set
# BR2_PACKAGE_SDL2_IMAGE is not set
# BR2_PACKAGE_SDL2_MIXER is not set
# BR2_PACKAGE_SDL2_NET is not set
# BR2_PACKAGE_SDL2_TTF is not set
# BR2_PACKAGE_VULKAN_HEADERS is not set

# Bluetooth — removed. No product function uses it, yet bluez5_utils installs
# S40bluetoothd, which ran a root daemon at every boot whether or not a radio
# attached (found 2026-08-10 by checking the packed rootfs rather than the
# tree). Dropping bluez5_utils also drops the dbus that only it and pulseaudio
# held in; avahi is configured daemon-only and does not need it.
# BR2_PACKAGE_BLUEZ_TOOLS is not set
# BR2_PACKAGE_BLUEZ5_UTILS is not set
# BR2_PACKAGE_DBUS_CPP is not set
# BR2_PACKAGE_DBUS_TRIGGERD is not set

BR2_PACKAGE_GZIP=y
BR2_PACKAGE_UNZIP=y
BR2_PACKAGE_XZ=y
# Archivers with findings and no consumer: p7zip and zip were selected
# directly by the BSP defconfig. gzip/unzip/xz are kept — the console's
# configuration export and the support bundle use them.
# BR2_PACKAGE_P7ZIP is not set
# BR2_PACKAGE_ZIP is not set
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_EVTEST=y

# Python: the interpreter is KEPT, the third-party modules are not.
#
# Neither product uses python at runtime (no reference in any init script, CGI
# or daemon), but the on-device bench tooling does —
# satisense-edge/scripts/bench/{encoder-sim,modbus-slave,...}.py run ON the
# device and are how TC-S3 and the commissioning gates are executed against a
# flashed image. They import only the standard library plus `ssl`, so
# python3 + PYTHON3_SSL is the whole requirement.
#
# Removing the interpreter as well would close 5 more findings and is the
# right end state for a shipped image, but it would mean validating an image
# that is not the one we test on. Tracked as a dated row in
# scripts/compliance/cve-triage.csv instead of silently kept.
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y
# zlib was previously enabled only as a side effect of python-pillow. Kept
# explicitly: libzlib is in the image regardless (so it adds no component), and
# a stdlib without it fails in ways that look like a bench-script bug.
BR2_PACKAGE_PYTHON3_ZLIB=y
