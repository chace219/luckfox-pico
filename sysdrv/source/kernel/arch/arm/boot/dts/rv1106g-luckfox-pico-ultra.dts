/dts-v1/;
#include "rv1106.dtsi"
#include "rv1106-luckfox-pico-ultra-ipc.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/display/media-bus-format.h>

/ {
	model = "Luckfox Pico Ultra";
	compatible = "rockchip,rv1103g-38x38-ipc-v10", "rockchip,rv1106g3";

	/*
	 * Shared oscillator for both MCP251863 modules (can@0 and can@2).
	 * Must match the actual X1 crystal on the modules: the driver takes
	 * this as SYSCLK directly (it never enables the MCP's PLL), so a
	 * mismatch silently scales every bit rate - the link reports the
	 * requested bitrate while the wire runs at another.
	 *
	 * 40 MHz is bench-verified, NOT a guess: at 20 MHz the driver computed
	 * tq 50ns and both channels went silent (cansend produced nothing on
	 * the USB CAN FD analyser); at 40 MHz it computes tq 25ns / brp 1,
	 * which divides to exactly 500 kbit/s and passes traffic both ways.
	 * Schematic 89-S&C-R0 shows a 20 MHz X1 - that symbol does not match
	 * the modules actually fitted. Do not "correct" this to 20 MHz.
	 */
	mcp251xfd_osc: mcp251xfd-osc {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <40000000>;
	};

	restart-poweroff {
		compatible = "restart-poweroff";
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		reset-gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_LOW>;
	};

	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <&uart1m0_rtsn>;
		pinctrl-1 = <&uart1_gpios>;
		BT,wake_gpio     = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&pinctrl {
	lan8651 {
		lan8651_cs_pin: lan8651-cs-pin {
			rockchip,pins = <1 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		lan8651_int_pin: lan8651-int-pin {
			rockchip,pins = <1 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	mcp251xfd {
		/*
		 * SPI0 CS0 pin (GPIO1_C0) driven as a plain GPIO chip-select.
		 * The Rockchip SPI controller (SPI_MASTER_GPIO_SS) also asserts
		 * native SER[0] on every GPIO-CS transfer, so the MCP must NOT
		 * sit on native CS0 while the LAN8651 uses a GPIO CS - otherwise
		 * LAN8651 traffic re-selects the CAN controller and corrupts it.
		 * Making both devices GPIO-CS keeps them isolated.
		 */
		mcp251xfd_cs_pin: mcp251xfd-cs-pin {
			rockchip,pins = <1 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		mcp251xfd_int_pin: mcp251xfd-int-pin {
			rockchip,pins = <2 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	mcp251xfd2 {
		/*
		 * Second MCP251863 on the same SPI0 bus, GPIO chip-select for the
		 * same reason as CS0/CS1 above. GPIO2_A4/A5 are otherwise idle on
		 * this board: their alternate mux is UART1_M1, and the Ultra's
		 * Bluetooth uses uart1m0 (GPIO1_A3/A4), not uart1m1.
		 * NOTE: the pad default bias for this pair is pull-down (cf.
		 * sdmmc1m0_idle_pins), so CS needs an external 10k pull-up to keep
		 * it deasserted in the window before pinctrl runs at boot.
		 */
		mcp251xfd2_cs_pin: mcp251xfd2-cs-pin {
			rockchip,pins = <2 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		mcp251xfd2_int_pin: mcp251xfd2-int-pin {
			rockchip,pins = <2 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

