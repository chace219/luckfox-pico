/**********FLASH**********/
&sfc {
	status = "okay";
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

/**********SDMMC**********/
&sdmmc {
	max-freqency = <50000000>;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;

	//sdio
	cap-sdio-irq;
	non-removable;
	no-1-8-v;
	supports-sdio;

	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	status = "okay";
};

/**********ETH**********/
&gmac {
	status = "okay";
};

/**********USB**********/
&u2phy {
	status = "okay";
};

&u2phy_otg {
	rockchip,dis-u2-susphy;
	status = "okay";
};

&usbdrd {
	status = "okay";
};

&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

/**********SPI**********/
&spi0 {
	status = "okay";
	num-cs = <3>;
	/*
	 * CS0 = MCP251xFD #1 (GPIO1_C0), CS1 = LAN8651 (GPIO2_A2),
	 * CS2 = MCP251xFD #2 (GPIO2_A4); all GPIO, no native CS.
	 */
	cs-gpios = <&gpio1 RK_PC0 GPIO_ACTIVE_LOW>,
		   <&gpio2 RK_PA2 GPIO_ACTIVE_LOW>,
		   <&gpio2 RK_PA4 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi0m0_clk &spi0m0_miso &spi0m0_mosi &mcp251xfd_cs_pin
			     &lan8651_cs_pin &lan8651_int_pin &mcp251xfd_int_pin
			     &mcp251xfd2_cs_pin &mcp251xfd2_int_pin>;
	/delete-node/ spidev@0;
	/delete-node/ fbtft@0;

	mcp251xfd: can@0 {
		compatible = "microchip,mcp251xfd";
		reg = <0>;
		/* 8 MHz: derated from 10 MHz (ADR-013; chip max is 17 MHz = 85% of
		 * SYSCLK/2 at 40 MHz) after CRC read errors on the shared SPI0 bus.
		 * Keeps ~1.6x headroom over worst-case CAN FD 500k/2M SPI traffic;
		 * do not lower further - transfers would occupy the shared bus even
		 * longer, delaying LAN8651 OA-TC6 data-path servicing. */
		spi-max-frequency = <8000000>;
		clocks = <&mcp251xfd_osc>;
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PA7 IRQ_TYPE_LEVEL_LOW>;
		status = "okay";
	};

	lan8651: ethernet@1 {
		compatible = "microchip,lan8651";
		reg = <1>;
		/* 15 MHz: 25 MHz caused OA-TC6 'ctrl write echo mismatch' on the
		 * shared SPI0 bus (cf. MCP251863 at 10 MHz, ADR-013). See the Ultra
		 * DTS for the full derating history. */
		spi-max-frequency = <15000000>;
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PA3 IRQ_TYPE_EDGE_FALLING>;
		microchip,plca-enable;
		microchip,plca-node-id = <0>;	/* 0 = PLCA coordinator (generates the BEACON) */
		microchip,plca-node-count = <8>;
		status = "okay";
	};

	mcp251xfd2: can@2 {
		compatible = "microchip,mcp251xfd";
		reg = <2>;
		/* Same derate as can@0 - see the comment there. */
		spi-max-frequency = <8000000>;
		clocks = <&mcp251xfd_osc>;
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PA5 IRQ_TYPE_LEVEL_LOW>;
		status = "okay";
	};
};

/**********I2C**********/
/* I2C3_M1 */
&i2c3 {
	status = "disabled";
	clock-frequency = <100000>;
};

/* I2C1_M1 */
&i2c1 {
	status = "disabled";
	clock-frequency = <100000>;
};


/**********UART**********/
/* UART3_M1 */
&uart3 {
	status = "disabled";
};

/* UART4_M1 */
&uart4 {
	status = "disabled";
};

/**********RTC**********/
&rtc {
	status = "okay";
};
