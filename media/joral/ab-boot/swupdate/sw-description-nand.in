/*
 * sw-description — SPI NAND (Luckfox Pico Max) variant.
 *
 * The eMMC variant is sw-description.in. Two files rather than one
 * conditional file because the difference is not a parameter: the handler,
 * the target syntax and the failure modes all differ.
 *
 *   eMMC   type = "raw"    device = "/dev/mmcblk0p9"   (block, absolute)
 *   NAND   type = "ubivol" device = "rootfs_a"         (UBI volume, by NAME)
 *
 * The ubivol handler needs CONFIG_MTD + CONFIG_UBIVOL in swupdate-joral.config
 * and BR2_PACKAGE_MTD in the buildroot defconfig (it stages libmtd/libubi).
 * Without them SWUpdate builds cleanly and then fails at INSTALL time with an
 * unknown handler — a build-green, field-broken combination, which is why the
 * hardening gate checks for the handler rather than trusting the config.
 *
 * Volume naming: the rootfs slot volumes come from the BUILD, not from
 * S20linkmount — build_mkimg packs the rootfs tree twice on an A/B NAND
 * layout, ubinizing one volume named rootfs_a and one named rootfs_b, and
 * the factory map flashes rootfs_a.img/rootfs_b.img to the matching
 * partitions. The distinct names are LOAD-BEARING: this handler addresses a
 * volume by NAME across every attached UBI device, so two slots both
 * carrying a volume called "rootfs" would leave one of them unaddressable.
 * That naming also makes this file index-independent where the eMMC one is
 * not. (S20linkmount's ubiattach/ubimkvol path still provisions the EMPTY
 * ubifs partitions — oem, userdata — on first boot.)
 *
 * Slot selection is the same initramfs design as the Ultra (SPL and U-Boot
 * untouched — see initramfs/init): misc_ab reads and erase-writes the AVB
 * record on the misc MTD char device, init attaches the chosen slot's UBI
 * device and mounts volume 0 by node. An earlier revision of this header
 * claimed the blocker was spl_ab.c's blk_dread() on MTD; that was a
 * misdiagnosis — SPL never reads misc in this design, on either board.
 *
 * The payload named below is the raw UBIFS LEB stream (ubiupdatevol
 * semantics, written INTO the existing volume), which ./build.sh swu
 * extracts byte-for-byte from the flashable rootfs_a.img with
 * scripts/compliance/ubifs-read.py.
 */
software = {
	version = "@VERSION@";
	description = "Joral edge platform rootfs (media-gateway + satisense-edge), build @BUILD@";

	stable = {
		a = {
			images: ({
				filename = "rootfs.img";
				/* `volume`, NOT `device`: the parser fills the ubivol
				 * handler's target from the volume attribute
				 * (parser.c GET_FIELD_STRING(..., "volume", ...));
				 * a device= here would install nothing. */
				volume = "rootfs_a";
				type = "ubivol";
				sha256 = "@SHA256@";
				/* Same reasoning as the eMMC variant: stream to the
				 * handler instead of staging in /tmp, which is a
				 * RAM-backed tmpfs far smaller than the image. The
				 * target is always the INACTIVE slot. */
				installed-directly = true;
			});
		};
		b = {
			images: ({
				filename = "rootfs.img";
				volume = "rootfs_b";
				type = "ubivol";
				sha256 = "@SHA256@";
				installed-directly = true;
			});
		};
	};
};
