/*
 * sw-description template — filled by `./build.sh swu`
 * (@VERSION@, @BUILD@, @SHA256@).
 *
 * One .swu carries the rootfs image once, deliverable to EITHER slot: the
 * two `stable` modes select the target partition, and the console CGI picks
 * the INACTIVE slot at apply time (`swupdate -e stable,<a|b>` after asking
 * misc_ab which slot is running). Partition indices match the -AB board
 * profile: p9 = rootfs_a, p10 = rootfs_b — reflashing the RUNNING slot is
 * impossible by construction because the CGI always names the other one.
 *
 * sha256 per image + CMS signature over this file: the signature covers the
 * hashes, the hashes cover the payload, so nothing installs unless the
 * whole chain verifies (fw-sign.sh / policy A.4).
 *
 * VERSION is the release identity, YYYY.MM.PATCH (media/joral/RELEASE_VERSION).
 * `./build.sh swu` does not read that file to fill this in — it reads
 * /etc/sw-versions back OUT of the rootfs image being packed, so the version
 * declared here is by construction the version the unit will report once the
 * image is installed. BUILD is git provenance for support cases and carries no
 * ordering; nothing compares it.
 *
 * DOWNGRADE POLICY (implemented 2026-08-15, one-way door #4 closed): the
 * console orders this version against the running one and refuses an install
 * that is not an upgrade unless the operator types DOWNGRADE, auditing the
 * attempt either way. The gate lives in api-update.sh + swu-version.sh rather
 * than here, deliberately:
 *
 *   - SWUpdate's own `install-if-higher` would make a rollback IMPOSSIBLE, and
 *     rolling back to a known-good release is a legitimate recovery action —
 *     one an operator may need precisely when a unit is misbehaving in the
 *     field and the automatic A/B rollback has already been consumed;
 *   - the gate belongs where the operator and the audit log are. A refusal
 *     from the installer would be an opaque failure; a refusal from the
 *     console names both versions and records who overrode it.
 *
 * What it is NOT: protection against an attacker who already holds console
 * credentials — they can type the phrase. It converts a SILENT signed rollback
 * into a warned, explicitly confirmed and audited one. The signature check is
 * orthogonal and cannot help here: CMS attests who built an image, never when.
 */
software = {
	version = "@VERSION@";
	description = "Joral edge platform rootfs (media-gateway + satisense-edge), build @BUILD@";

	stable = {
		a = {
			images: ({
				filename = "rootfs.img";
				device = "/dev/mmcblk0p9";
				type = "raw";
				sha256 = "@SHA256@";
				/* Stream straight to the handler. Without this SWUpdate
				 * first extracts the payload to TMPDIR — /tmp is a
				 * RAM-backed tmpfs far smaller than the image, and the
				 * overflow kills the extractor mid-stream ("Connection
				 * reset by peer", found on the bench 2026-08-14). Safe:
				 * the target is always the INACTIVE slot, which is only
				 * marked active after swupdate exits clean. */
				installed-directly = true;
			});
		};
		b = {
			images: ({
				filename = "rootfs.img";
				device = "/dev/mmcblk0p10";
				type = "raw";
				sha256 = "@SHA256@";
				installed-directly = true;
			});
		};
	};
};
