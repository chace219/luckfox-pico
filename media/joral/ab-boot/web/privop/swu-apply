# privop/swu-apply — launch the detached A/B install of the staged package.
#
#   swu-apply <target a|b> <user> <running-version> <staged-version>
#
# The CGI has already taken the operation flock (fd 9, which the dispatcher
# passes through), classified the package and run the downgrade gate; this
# verb re-checks the one property that must hold at the ROOT boundary — the
# target is never the running slot — resets the progress bookkeeping (as
# root, because /tmp is sticky and the www-data CGI cannot remove root-owned
# files), and hands the install to swu-install.sh under setsid. The worker
# inherits fd 9 and keeps the operation locked for as long as it runs.
#
# Exit / first stdout line:
#   0 ok          worker launched
#   2 usage       bad arguments
#   3 no_slot     no A/B layout or unreadable misc record
#   4 running     refused: target is the running slot
#   5 no_package  nothing staged
#   6 no_worker   swu-install.sh missing beside webauth.sh
#
# Shared verb: byte-identical in both product trees. SWU_PREFIX roots the
# paths for tests/test_privop.sh; the dispatcher scrubs it on a device.
set -u
R="${SWU_PREFIX:-}"
STAGED=$R/userdata/update.swu
APPLY_PID=$R/tmp/swu-apply.pid
APPLY_PCT=$R/tmp/swu-apply.pct
APPLY_STATE=$R/tmp/swu-apply.state

[ $# -eq 4 ] || { echo usage; exit 2; }
TARGET=$1; AUSER=$2; FROM=$3; TO=$4
case "$TARGET" in a|b) ;; *) echo usage; exit 2 ;; esac
# The acting user and the two release strings go into audit records; an
# audit field has no business carrying anything outside this alphabet.
for v in "$AUSER" "$FROM" "$TO"; do
	case "$v" in *[!A-Za-z0-9._@-]*) echo usage; exit 2 ;; esac
	[ ${#v} -le 64 ] || { echo usage; exit 2; }
done
[ -n "$AUSER" ] || { echo usage; exit 2; }

find_part() {
	for u in "$R"/sys/block/mmcblk*/mmcblk*/uevent; do
		[ -f "$u" ] || continue
		if grep -q "^PARTNAME=$1$" "$u"; then
			echo "$R/dev/$(grep '^DEVNAME=' "$u" | cut -d= -f2)"
			return 0
		fi
	done
	return 1
}
MISC=$(find_part misc) || { echo no_slot; exit 3; }
CUR=$(misc_ab status "$MISC" 2>/dev/null | sed -n 's/^last_boot=//p')
case "$CUR" in a|b) ;; *) echo no_slot; exit 3 ;; esac
[ "$CUR" != "$TARGET" ] || { echo running; exit 4; }
[ -f "$STAGED" ] || { echo no_package; exit 5; }

INSTALLER="$(dirname "$0")/../swu-install.sh"
[ -x "$INSTALLER" ] || { echo no_worker; exit 6; }

umask 022
echo 0 > "$APPLY_PCT"
rm -f "$APPLY_STATE" "$APPLY_PID"
# fd 9 (the flock) is inherited here deliberately; everything else is off the
# CGI's sockets so httpd can close the response at once.
setsid "$INSTALLER" "$STAGED" "$TARGET" "$MISC" "$AUSER" "${FROM:-unknown}" "${TO:-unknown}" \
	>/dev/null 2>&1 </dev/null &
echo ok
exit 0
