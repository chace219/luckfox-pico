#!/bin/sh
# SPDX-License-Identifier: LicenseRef-Joral-Proprietary
# Copyright (c) 2026 Joral LLC. All rights reserved.
# api-update.sh — console CGI for the A/B firmware update (CRA Annex I #7).
#
# TEMPLATE: each product tree installs a copy with @WEBAUTH@ replaced by its
# own auth library path (see media/joral/ab-boot/README.md). Everything else
# is identical on both products — the update is a PLATFORM operation (one
# shared rootfs), the consoles are just two doors to it.
#
# Actions (all require an authenticated session; every one is audit-logged):
#   GET  ?action=status   slot table (misc_ab), staged-.swu info, layout
#   POST ?action=upload   raw .swu body -> staged to /userdata/update.swu,
#                         then VERIFIED (swupdate -c: signature + hashes)
#                         before it is reported as ready. A file that fails
#                         verification is deleted on the spot.
#   POST ?action=apply    install the staged .swu to the INACTIVE slot
#                         (swupdate -e stable,<other>), mark-active on
#                         success. The unit keeps serving throughout;
#                         the switch happens at the next reboot.
#                         REFUSED with code=confirm_required unless the package
#                         is an upgrade or a reinstall — see the downgrade gate
#                         below; override with &confirm=DOWNGRADE.
#   POST ?action=reboot   reboot the unit — the operator's explicit "switch
#                         now". DELIBERATELY not automatic after apply: this
#                         gateway carries machine-control traffic, and only
#                         the operator knows when the maintenance window is.
#                         Deferred switching is exactly what A/B buys.
#
# Security posture, in the ADR-130 discipline:
#   - no client-supplied filesystem paths — the staging path is fixed;
#   - the ONLY trust decision is swupdate's own CMS verification against
#     /etc/swupdate/trusted-certs.pem (the same check a tampered or
#     wrong-key .swu fails on the bench);
#   - the running slot can never be written: the target is computed from
#     misc_ab last_boot, never taken from the client — and re-checked on the
#     root side of the privilege boundary (privop/swu-apply);
#   - upload and apply are separate steps so the operator confirms against
#     the verified version string, not a filename;
#   - a package that is not an upgrade needs the operator to type a phrase,
#     re-checked HERE and not in the console JavaScript, so it also covers a
#     caller driving the CGI directly.
#
# This CGI runs as www-data. The four things in it that need root — reading
# the misc partition, receiving and verifying the package into /userdata,
# launching the install worker, and the reboot — are the privop verbs
# misc-status / swu-stage / swu-apply / reboot (console-privilege-separation-
# plan.md). The decisions stay HERE: the gate, the audit records and the
# responses are this script's; the verbs perform and re-validate.
#
# The downgrade gate (one-way door #4, swupdate-implementation-plan.md
# "Item 5"). The signature says a package is genuinely ours; it says nothing
# about its AGE, because CMS attests who built an image and never when. So a
# properly signed old release — one a published advisory already covers —
# would install over a fixed one with no warning at all. The release identity
# is what makes that visible: swu-version.sh orders the staged package against
# the running one, and anything that is not `newer` or `same` needs an explicit
# typed confirmation. "unknown" counts as needing it, which is what a unit
# running a pre-scheme image reports.
WEBAUTH=@WEBAUTH@

# SWU_PREFIX roots every path this script touches — empty on a real device, a
# scratch tree under tests/. Same idiom as the factory reset's MG_RESET_PREFIX
# and for the same reason: the script that ships has to be the script the
# downgrade-gate test drives, or the gate is only ever tested by reimplementing
# it. It is a prefix, never a substitute: the shipped defaults are still right
# here in the source.
R="${SWU_PREFIX:-}"

# The release identity of THIS rootfs. Set before the library is sourced so the
# prefix reaches it too; the library's own default is the bare /etc path.
SW_VERSIONS_FILE="${SW_VERSIONS_FILE:-$R/etc/sw-versions}"

. "$WEBAUTH"
# Beside webauth.sh, installed by the same product Makefile.
. "$(dirname "$WEBAUTH")/swu-version.sh"
require_auth

STAGED=$R/userdata/update.swu
CHECK_LOG=$R/tmp/swu-check.log
# Detached-install bookkeeping (see the apply/progress actions). Small files in
# /tmp, written by the root-side worker; this script only reads them.
APPLY_PID=$R/tmp/swu-apply.pid
APPLY_PCT=$R/tmp/swu-apply.pct
APPLY_STATE=$R/tmp/swu-apply.state
OP_LOCK=$R/tmp/swu-op.lock   # flock target, see op_lock() below

printf 'Content-Type: application/json\r\n\r\n'

qs_get() { echo "$QUERY_STRING" | tr '&' '\n' | sed -n "s/^$1=//p" | head -n1; }
ACTION=$(qs_get action)

find_part() { # by PARTNAME, same method as the initramfs / S99ab-health
	for u in "$R"/sys/block/mmcblk*/mmcblk*/uevent; do
		[ -f "$u" ] || continue
		if grep -q "^PARTNAME=$1$" "$u"; then
			echo "$R/dev/$(grep '^DEVNAME=' "$u" | cut -d= -f2)"
			return 0
		fi
	done
	# SPI NAND (Pico Max): partitions are mtd devices named by mtdparts=.
	for n in "$R"/sys/class/mtd/mtd*/name; do
		[ -f "$n" ] || continue
		case "$n" in */mtd*ro/name) continue ;; esac
		if [ "$(cat "$n")" = "$1" ]; then
			echo "$R/dev/$(basename "$(dirname "$n")")"
			return 0
		fi
	done
	return 1
}

json_escape() { sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' ' '; }

# Mutual exclusion for the two MUTATING operations. Both touch shared state --
# upload replaces the single staged package, apply writes a rootfs slot -- and a
# check-then-act test ("is a pid file there?") is not enough: two requests can
# both pass the test before either records itself, and two SWUpdate processes
# writing the same slot corrupt it.
#
# flock, not a lock file we manage ourselves. The lock lives in the KERNEL and
# is attached to the open descriptor, so it is released automatically when the
# holder exits -- however it exits. That removes the entire stale-lock problem:
# there is no leftover state to inspect, and therefore no "is the holder still
# alive?" test, which cannot be made race-free in shell. Two earlier attempts
# here (pid file, then mkdir + pid check) both let a second caller in while a
# first was recovering a stale lock.
#
# The descriptor is inherited across fork and exec, so the DETACHED installer
# keeps holding the same lock for as long as it runs, with no handover. The
# privop dispatcher passes fd 9 — and only fd 9 — through to the root side for
# exactly this reason.
op_lock() {
	exec 9>>"$OP_LOCK" || return 1
	flock -n 9
}
op_unlock() { flock -u 9 2>/dev/null; exec 9>&-; }

# The A/B slot record. misc is a block device this CGI cannot read, so the
# verb reads it; the verb takes no arguments and finds the partition itself.
misc_status() { privop misc-status 2>/dev/null; }

# The slot an install would target: the one NOT booted last. Echoes "a" or
# "b"; fails on a single-slot layout or an unreadable misc record.
inactive_slot() {
	local cur
	cur=$(misc_status | sed -n 's/^last_boot=//p')
	case "$cur" in
		a) echo b ;;
		b) echo a ;;
		*) return 1 ;;
	esac
}

slot_json() { # emits {"layout":...,"slots":...,"pending":...} fragment
	MISC=$(find_part misc) || { printf '"layout":"single-slot"'; return; }
	RAW=$(misc_status)
	S=$(printf '%s' "$RAW" | json_escape)
	# A switch is pending when the slot the selector would boot next differs
	# from the one running now — i.e. an installed update is waiting for the
	# reboot. The UI keys its "Reboot now to switch" button off this.
	CHOICE=$(printf '%s' "$RAW" | sed -n 's/^choice=//p')
	LASTB=$(printf '%s' "$RAW" | sed -n 's/^last_boot=//p')
	PEND=false
	[ -n "$CHOICE" ] && [ "$CHOICE" != "none" ] && [ "$CHOICE" != "$LASTB" ] && PEND=true
	printf '"layout":"ab","misc":"%s","slots":"%s","pending":%s' "$MISC" "$S" "$PEND"
}

# The release this rootfs carries, or "" on an image built before the scheme.
# Read once per request: it cannot change while the CGI runs (a new release
# only takes effect after a reboot into the other slot).
RUNNING=$(sw_version_running 2>/dev/null) || RUNNING=""

staged_json() {
	if [ -f "$STAGED" ]; then
		V=$(sw_version_from_swu "$STAGED") || V=""
		ORD=$(sw_version_order "$RUNNING" "$V")
		# `downgrade` is the UI's cue to demand the typed phrase. It is the
		# same predicate the apply action enforces — exported here only so the
		# console can warn BEFORE the operator commits, never as the control
		# itself.
		if sw_version_needs_confirm "$ORD"; then DG=true; else DG=false; fi
		printf ',"staged":{"present":true,"version":"%s","order":"%s","downgrade":%s,"bytes":%s}' \
			"$V" "$ORD" "$DG" "$(wc -c < "$STAGED")"
	else
		printf ',"staged":{"present":false}'
	fi
}

case "$ACTION" in
status)
	# running_version is "" on a pre-scheme image; the console says so rather
	# than showing a blank, because "we cannot tell what this unit runs" is
	# itself the answer an operator needs before installing anything.
	printf '{"ok":true,"running_version":"%s",' "$RUNNING"
	slot_json
	staged_json
	printf '}'
	;;

upload)
	[ "$REQUEST_METHOD" = "POST" ] || { printf '{"ok":false,"error":"POST required"}'; exit 0; }
	# A missing updater is an image-build defect, not a bad signature —
	# report it as itself (and before streaming a 150 MB body).
	if ! command -v swupdate >/dev/null 2>&1; then
		audit_log fw_upload fail "$(current_user)" "reason=swupdate_missing"
		printf '{"ok":false,"error":"swupdate binary missing from this image — reflash a rootfs built with SWUpdate enabled"}'; exit 0
	fi
	# One mutating operation at a time: a second upload would interleave into
	# the same staging file, and an upload must not swap the package out from
	# under a running install.
	op_lock || {
		printf '{"ok":false,"error":"another update operation is in progress — wait for it to finish"}'; exit 0
	}
	trap op_unlock EXIT INT TERM
	len="${CONTENT_LENGTH:-0}"
	case "$len" in ''|*[!0-9]*) len=0 ;; esac
	if [ "$len" -lt 512 ] || [ "$len" -gt 268435456 ]; then
		printf '{"ok":false,"error":"body must be 512..268435456 bytes"}'; exit 0
	fi
	# Space check before we stream a couple hundred MB at /userdata.
	free_kb=$(df -k "$R/userdata" 2>/dev/null | awk 'NR==2{print $4}')
	if [ -n "$free_kb" ] && [ $((len / 1024 + 4096)) -gt "$free_kb" ]; then
		printf '{"ok":false,"error":"not enough space on /userdata"}'; exit 0
	fi
	# The body goes to the root side on THIS process's stdin: swu-stage reads
	# exactly $len bytes into the fixed staging path, verifies BEFORE accepting
	# (signature chain + per-image sha256, with the SAME software-set selection
	# the install will use — without -e this two-mode sw-description selects
	# nothing and swupdate 2022.12 aborts with only a bare "Image invalid or
	# corrupted"; -c is a dry run, nothing is written to the slot), and renames
	# onto the staged path only on success. Its first stdout line says why
	# when it does not.
	RES=$(privop swu-stage "$len" 2>/dev/null); rc=$?
	case "$rc:$RES" in
	0:ok*)
		V=$(sw_version_from_swu "$STAGED") || V=""
		# Order it now, so the console can warn the moment the package is
		# accepted rather than only when the operator clicks install. The
		# audit record carries the transition either way — "what was staged
		# onto what" is the question an incident review asks first.
		ORD=$(sw_version_order "$RUNNING" "$V")
		if sw_version_needs_confirm "$ORD"; then DG=true; else DG=false; fi
		audit_log fw_upload success "$(current_user)" \
			"version=$V running=$RUNNING order=$ORD bytes=$len"
		printf '{"ok":true,"verified":true,"version":"%s","order":"%s","downgrade":%s,"running":"%s"}' \
			"$V" "$ORD" "$DG" "$RUNNING"
		;;
	*:no_slot*)
		audit_log fw_upload fail "$(current_user)" "reason=no_slot"
		printf '{"ok":false,"error":"cannot determine target slot — single-slot layout or unreadable misc record"}'
		;;
	*:short_body*)
		audit_log fw_upload fail "$(current_user)" "reason=short_body $(printf '%s' "$RES" | sed 's/^short_body //')"
		printf '{"ok":false,"error":"short upload (%s)"}' "$(printf '%s' "$RES" | sed 's/^short_body //' | json_escape)"
		;;
	*:verify_failed*)
		# The PRIMARY error is an [ERROR] line that can scroll far above the
		# end of the log; a bare tail showed only secondary noise (broken
		# internal pipes) and cost two bench debugging rounds on 2026-08-14.
		ERR=$({ grep -iE "error|fail" "$CHECK_LOG" 2>/dev/null | head -n4;
			tail -n1 "$CHECK_LOG" 2>/dev/null; } | json_escape)
		audit_log fw_upload fail "$(current_user)" "reason=verify_failed"
		printf '{"ok":false,"error":"verification failed — wrong signature or corrupt file","detail":"%s"}' "$ERR"
		;;
	*)
		audit_log fw_upload fail "$(current_user)" "reason=stage_helper rc=$rc"
		printf '{"ok":false,"error":"the update helper could not stage the package (rc=%s)"}' "$rc"
		;;
	esac
	;;

apply)
	[ "$REQUEST_METHOD" = "POST" ] || { printf '{"ok":false,"error":"POST required"}'; exit 0; }
	if ! command -v swupdate >/dev/null 2>&1; then
		audit_log fw_apply fail "$(current_user)" "reason=swupdate_missing"
		printf '{"ok":false,"error":"swupdate binary missing from this image — reflash a rootfs built with SWUpdate enabled"}'; exit 0
	fi
	[ -f "$STAGED" ] || { printf '{"ok":false,"error":"no verified update staged — upload first"}'; exit 0; }
	MISC=$(find_part misc) || { printf '{"ok":false,"error":"single-slot layout — this image cannot A/B update"}'; exit 0; }
	TARGET=$(inactive_slot) || { printf '{"ok":false,"error":"cannot determine running slot"}'; exit 0; }

	# Exactly one installer, ever: two SWUpdate processes writing the same slot
	# would corrupt it. The lock is NOT released here -- the worker inherits it.
	#
	# The lock is taken BEFORE the staged package is classified below, and the
	# order is load-bearing. $STAGED is a shared, mutable path: `upload` renames
	# a freshly verified package onto it, and the install worker opens it BY
	# NAME minutes later. Classifying first and locking second leaves a
	# time-of-check/time-of-use window in which a concurrent authenticated
	# upload replaces the package between the decision and the install -- so a
	# signed OLDER release could be installed under a confirmation granted for a
	# newer one, with the audit record naming the wrong transition. Since upload
	# also takes this lock, holding it across classify -> decide -> launch (and
	# for the whole life of the worker, which inherits the descriptor) is what
	# makes the bytes that were checked the bytes that get installed.
	#
	# The earlier arrangement checked first, reasoning that "a refusal changes
	# nothing on the device, so it must not make a concurrent install wait".
	# That optimised the refusal path and opened the race; found in review
	# (Greptile) on satisense-edge#54 / t1s-media-gateway#30. A refusal now
	# costs a non-blocking flock attempt, which is the correct answer anyway --
	# a gate decision computed while another operation is mutating the package
	# is not a decision about the package that will be installed.
	op_lock || {
		printf '{"ok":true,"started":true,"target":"%s","note":"an update operation is already in progress"}' "$TARGET"; exit 0
	}

	# The downgrade gate, now over bytes that cannot change under us.
	SV=$(sw_version_from_swu "$STAGED") || SV=""
	ORD=$(sw_version_order "$RUNNING" "$SV")
	DG=false
	if sw_version_needs_confirm "$ORD"; then
		DG=true
		# Compared here, server-side, against the phrase the library defines.
		# The console arms its button on the same string, but that is a
		# convenience: this check is what a caller reaching the CGI directly
		# with curl also has to satisfy — the distinction between a control
		# and a screen (the same one the default-password gate turns on).
		if [ "$(qs_get confirm)" != "$SW_DOWNGRADE_PHRASE" ]; then
			audit_log fw_apply fail "$(current_user)" \
				"target=$TARGET reason=downgrade_unconfirmed order=$ORD from=$RUNNING to=$SV"
			printf '{"ok":false,"code":"confirm_required","order":"%s","running":"%s","staged":"%s","phrase":"%s",' \
				"$ORD" "$RUNNING" "$SV" "$SW_DOWNGRADE_PHRASE"
			if [ "$ORD" = older ]; then
				printf '"error":"%s is older than the running %s — installing it reintroduces anything fixed since. Confirm to proceed."}' \
					"$SV" "$RUNNING"
			else
				printf '"error":"cannot tell whether this package is newer or older than what this unit runs. Confirm to proceed."}'
			fi
			# No explicit unlock: the flock lives on fd 9 and the kernel drops
			# it when this process exits, however it exits. That is the whole
			# reason the lock is an flock and not a file we manage.
			exit 0
		fi
	fi
	# The version transition is part of the record, not just the slot: an
	# advisory names releases, so an audit trail that only says "slot b" cannot
	# answer whether a unit was ever running an affected build.
	audit_log fw_apply started "$(current_user)" \
		"target=$TARGET from=$RUNNING to=$SV order=$ORD downgrade=$DG"
	AUSER=$(current_user)
	# The install writes ~150 MB to the standby slot and takes a minute or two,
	# far longer than a browser will wait on one request. swu-apply resets the
	# progress bookkeeping and hands the install to the worker beside webauth.sh
	# under a fresh session (setsid) with fds off the HTTP socket, so httpd
	# closes THIS response at once while the install runs on. The browser then
	# polls ?action=progress. The worker INHERITS fd 9 — through the dispatcher,
	# which keeps exactly that descriptor — and with it the flock, so the lock
	# stays held for the whole install with no handover and nothing to clean up
	# if it dies. It stamps its own pid into $APPLY_PID for the progress action.
	# The verb re-checks the one invariant that must hold at the root boundary:
	# the target is never the running slot.
	RES=$(privop swu-apply "$TARGET" "$AUSER" "$RUNNING" "$SV" 2>/dev/null); rc=$?
	case "$rc:$RES" in
	0:ok*)
		printf '{"ok":true,"started":true,"target":"%s","note":"installing to the standby slot — poll ?action=progress"}' "$TARGET"
		;;
	*:no_worker*)
		audit_log fw_apply fail "$AUSER" "target=$TARGET reason=worker_missing"
		printf '{"ok":false,"error":"install worker missing from this image"}'
		;;
	*)
		audit_log fw_apply fail "$AUSER" "target=$TARGET reason=apply_helper rc=$rc detail=$(printf '%s' "$RES" | head -n1)"
		printf '{"ok":false,"error":"the update helper refused the install (%s)"}' "$(printf '%s' "$RES" | head -n1 | json_escape)"
		;;
	esac
	;;

progress)
	# Non-destructive poll for a running/finished install (see apply).
	PCT=$(cat "$APPLY_PCT" 2>/dev/null); case "$PCT" in ''|*[!0-9]*) PCT=0 ;; esac
	if [ -f "$APPLY_STATE" ]; then
		ST=$(cat "$APPLY_STATE")
		case "$ST" in
		done*)
			TGT=${ST#done target=}
			printf '{"ok":true,"state":"done","percent":100,"target":"%s","note":"reboot to switch; automatic rollback if the new slot fails to come up"}' "$TGT"
			;;
		*)
			DET=$(printf '%s' "${ST#fail }" | json_escape)
			printf '{"ok":false,"state":"failed","percent":%s,"error":"install failed — running system untouched","detail":"%s"}' "$PCT" "$DET"
			;;
		esac
	# /proc, not kill -0: the worker is root and this CGI is not, so a signal
	# probe would answer EPERM for a running install and report it idle.
	elif [ -f "$APPLY_PID" ] && [ -d "/proc/$(cat "$APPLY_PID" 2>/dev/null)" ]; then
		printf '{"ok":true,"state":"running","percent":%s}' "$PCT"
	else
		printf '{"ok":true,"state":"idle","percent":0}'
	fi
	;;

reboot)
	[ "$REQUEST_METHOD" = "POST" ] || { printf '{"ok":false,"error":"POST required"}'; exit 0; }
	# Refuse while ANY update operation is running: rebooting mid-write leaves
	# the standby slot half-written (recoverable — it was never marked active —
	# but it pointlessly burns the staged update), and mid-upload it discards
	# the transfer.
	#
	# Take the same flock rather than testing the pid file. The pid file is
	# written by the worker once it is scheduled, so a pid test has a blind
	# window between apply returning and the worker starting, and would let a
	# reboot through exactly when an install is being handed over. The lock has
	# no such window: the CGI holds it from before the launch and the worker
	# inherits it, so it is continuously held for the whole operation.
	op_lock || {
		printf '{"ok":false,"error":"an update operation is in progress — wait for it to finish, then reboot"}'; exit 0
	}
	trap op_unlock EXIT INT TERM
	audit_log fw_reboot requested "$(current_user)" ""
	# The verb detaches the actual reboot (sleep 2; sync; reboot) so this JSON
	# response reaches the browser before the unit goes down. 9>&- so neither
	# the helper nor the rebooter inherits the lock and keeps it held for its
	# two-second life (or longer, if the reboot stalls).
	privop reboot >/dev/null 2>&1 9>&-
	printf '{"ok":true,"note":"rebooting — the console drops for ~40 s, then answers from the newly selected slot"}'
	;;

*)
	printf '{"ok":false,"error":"action must be status|upload|apply|progress|reboot"}'
	;;
esac
exit 0
