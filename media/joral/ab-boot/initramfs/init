#!/bin/sh
# ab-boot initramfs /init — A/B slot selection in userspace.
#
# The design (media/joral/swupdate-implementation-plan.md, "Chosen design"):
# SPL and U-Boot proper are UNTOUCHED and load a single-copy kernel+initramfs
# from `boot`; this script then implements the same AVB slot semantics the
# bootloader would (misc_ab mirrors common/spl/spl_ab.c byte-exactly), mounts
# the chosen rootfs slot, and switch_roots into it.
#
# Slot state machine per boot:
#   1. `misc_ab select` picks the slot, burns a try if the slot is unproven,
#      records last_boot, and prints "a" or "b".
#   2. If mounting that slot fails, it is marked unbootable on the spot and
#      selection runs again — a corrupt slot costs one boot, not seven.
#   3. Userspace (S99ab-health, later work item) calls `misc_ab
#      mark-successful` once the services are up; until then every boot
#      spends a try, and 7 failures roll back to the other slot.
#
# ONE initramfs serves BOTH boards — it is packed into the boot FIT by
# build_ab_bootimg for whichever profile is lunched, so nothing here may
# assume the medium. Partitions are found by NAME, never by index:
#   Ultra (eMMC):    the kernel's cmdline partition parser publishes the
#                    blkdevparts= names in each partition's sysfs uevent.
#                    misc is a block device; rootfs slots are ext4.
#   Max (SPI NAND):  mtdparts= gives each mtd its partition name in
#                    /sys/class/mtd/mtdN/name. misc is the mtd CHAR device
#                    (misc_ab knows how to erase-write it); each rootfs slot
#                    is a UBI volume (attached here if the kernel's
#                    ubi.mtd= bootarg did not already do it) holding ubifs.
#
# Keep this script BUSYBOX-SH ONLY (no bashisms) and keep it small: it is the
# one component of the update design that is single-copy and cannot be fixed
# by an update without touching `boot`. The NAND path additionally needs the
# ubiattach applet — mkinitramfs.sh checks the busybox for it.

PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc     proc  /proc
mount -t sysfs    sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null

msg() { echo "ab-boot: $*"; }

# Resolve a partition name to its /dev node: eMMC uevents first, then MTD.
find_part() { # find_part <partname> -> echoes /dev/<node> or returns 1
	for u in /sys/block/mmcblk*/mmcblk*/uevent; do
		[ -f "$u" ] || continue
		if grep -q "^PARTNAME=$1$" "$u"; then
			echo "/dev/$(grep '^DEVNAME=' "$u" | cut -d= -f2)"
			return 0
		fi
	done
	for n in /sys/class/mtd/mtd*/name; do
		[ -f "$n" ] || continue
		case "$n" in */mtd*ro/name) continue ;; esac
		if [ "$(cat "$n")" = "$1" ]; then
			echo "/dev/$(basename "$(dirname "$n")")"
			return 0
		fi
	done
	return 1
}

# Mount a rootfs slot at /mnt, whatever the medium says it is.
#   eMMC:  the slot device is a block partition holding ext4.
#   NAND:  the slot device is /dev/mtdN; attach it as a UBI device (reusing
#          an attachment the kernel already made from ubi.mtd= bootargs) and
#          mount volume 0 — the ONLY volume the build's ubinize puts there —
#          by device node, so mounting never depends on the volume's name.
mount_slot() { # mount_slot <dev> -> 0 mounted at /mnt
	case "$1" in
	/dev/mtd*)
		mtdnum=${1#/dev/mtd}
		ubinum=
		for m in /sys/class/ubi/ubi*/mtd_num; do
			[ -f "$m" ] || continue
			if [ "$(cat "$m")" = "$mtdnum" ]; then
				ubinum=$(basename "$(dirname "$m")")
				ubinum=${ubinum#ubi}
				break
			fi
		done
		if [ -z "$ubinum" ]; then
			# -d <mtdnum>: same numbering convention S20linkmount
			# uses later for oem/userdata, so numbers never clash.
			ubiattach /dev/ubi_ctrl -m "$mtdnum" -d "$mtdnum" \
				>/dev/null 2>&1 || return 1
			ubinum=$mtdnum
		fi
		# devtmpfs may create the volume node a beat after the attach.
		[ -e "/dev/ubi${ubinum}_0" ] || sleep 1
		mount -o ro -t ubifs "/dev/ubi${ubinum}_0" /mnt
		;;
	*)
		mount -o ro -t ext4 "$1" /mnt
		;;
	esac
}

fatal() {
	msg "FATAL: $*"
	msg "dropping to a shell (bench build; production policy is reboot)"
	exec sh
}

MISC=$(find_part misc) || fatal "no 'misc' partition — wrong blkdevparts/mtdparts?"

tries=0
while [ "$tries" -lt 2 ]; do
	SLOT=$(misc_ab select "$MISC") || fatal "misc_ab select failed on $MISC"
	DEV=$(find_part "rootfs_$SLOT") || fatal "no 'rootfs_$SLOT' partition"

	msg "slot $SLOT -> $DEV"
	# ro here; the system's own inittab remounts rw. A rootfs that cannot
	# even mount read-only has nothing to say for itself.
	if mount_slot "$DEV"; then
		if [ -x /mnt/sbin/init ]; then
			msg "switching root to $DEV"
			mount --move /proc /mnt/proc 2>/dev/null || umount /proc
			mount --move /sys  /mnt/sys  2>/dev/null || umount /sys
			mount --move /dev  /mnt/dev  2>/dev/null
			exec switch_root /mnt /sbin/init
		fi
		msg "slot $SLOT mounts but has no /sbin/init"
		umount /mnt
	else
		msg "slot $SLOT failed to mount"
	fi

	# This slot is broken NOW — don't spend six more boots proving it.
	misc_ab mark-unbootable "$MISC" "$SLOT"
	tries=$((tries + 1))
done

fatal "no bootable rootfs slot"
