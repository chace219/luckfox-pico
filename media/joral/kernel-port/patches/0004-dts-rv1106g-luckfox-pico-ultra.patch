 /**********BT**********/
 &uart1 {
 	status = "okay";
@@ -139,8 +213,46 @@ uart1_gpios: uart1-gpios {
 
 /**********SPI**********/
 &spi0 {
-	status = "disabled";
-	spidev@0 {
-		spi-max-frequency = <50000000>;
+	status = "okay";
+	num-cs = <2>;
+	/* CS0 = MCP251xFD (GPIO1_C0), CS1 = LAN8651 (GPIO1_B2); both GPIO, no native CS */
+	cs-gpios = <&gpio1 RK_PC0 GPIO_ACTIVE_LOW>, <&gpio1 RK_PB2 GPIO_ACTIVE_LOW>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi0m0_clk &spi0m0_miso &spi0m0_mosi &mcp251xfd_cs_pin
+				     &lan8651_cs_pin &lan8651_int_pin &mcp251xfd_int_pin>;
+	/delete-node/ spidev@0;
+
+	mcp251xfd: can@0 {
+		compatible = "microchip,mcp251xfd";
+		reg = <0>;
+		/* 8 MHz: derated from 10 MHz (ADR-013; chip max is 17 MHz = 85% of
+		 * SYSCLK/2 at 40 MHz) after CRC read errors on the shared SPI0 bus.
+		 * Keeps ~1.6x headroom over worst-case CAN FD 500k/2M SPI traffic;
+		 * do not lower further - transfers would occupy the shared bus even
+		 * longer, delaying LAN8651 OA-TC6 data-path servicing. */
+		spi-max-frequency = <8000000>;
+		clocks = <&mcp251xfd_osc>;
+		interrupt-parent = <&gpio2>;
+		interrupts = <RK_PA7 IRQ_TYPE_LEVEL_LOW>;
+		status = "okay";
+	};
+
+	lan8651: ethernet@1 {
+		compatible = "microchip,lan8651";
+		reg = <1>;
+		/* 15 MHz: 25 MHz caused OA-TC6 'ctrl write echo mismatch' on the
+		 * shared SPI0 bus (cf. MCP251863 at 10 MHz, ADR-013). Lowering to
+		 * 10 MHz did NOT cure the runtime 'Config unsync error' wedge (it
+		 * hit within a minute of boot vs ~23 h at 15 MHz), so the wedge is
+		 * not clock-rate-bound; 15 MHz keeps SPI headroom above the 10 Mbps
+		 * T1S line rate (~6% OA-TC6 chunk overhead) while the root cause
+		 * (bus contention vs signal integrity) is isolated. */
+		spi-max-frequency = <15000000>;
+		interrupt-parent = <&gpio1>;
+		interrupts = <RK_PB3 IRQ_TYPE_EDGE_FALLING>;
+		microchip,plca-enable;
+		microchip,plca-node-id = <0>;	/* 0 = PLCA coordinator (generates the BEACON) */
+		microchip,plca-node-count = <8>;
+		status = "okay";
 	};
 };
