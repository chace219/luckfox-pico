# /etc/inittab
#
# Copyright (C) 2001 Erik Andersen <andersen@codepoet.org>
#
# Note: BusyBox init doesn't support runlevels.  The runlevels field is
# completely ignored by BusyBox init. If you want runlevels, use
# sysvinit.
#
# Format for each entry: <id>:<runlevels>:<action>:<process>
#
# id        == tty to run on, or empty for /dev/console
# runlevels == ignored
# action    == one of sysinit, respawn, askfirst, wait, and once
# process   == program to run

# Startup the system
::sysinit:/bin/mount -a 2>/dev/null
# now run any rc scripts
# 2026-08-21 (CRA compliance plan item 13): the line below was
#
#     ::respawn:-/bin/sh
#
# a root shell respawned on the console with no authentication of any kind —
# not even the one shared password the buildroot profiles' getty asked for.
# It survived every hardening pass so far because the profiles that carry it
# ship their own inittab from this overlay, applied AFTER the post-build
# hardening that edits the buildroot skeleton's.
#
# Re-enabling it for bring-up is a deliberate act on a bench image; it must not
# be committed. scripts/compliance/check-board-hardening.sh fails if it comes
# back.
#::respawn:-/bin/sh
::sysinit:/etc/init.d/rcS

# Put a getty on the serial port
#ttyFIQ0::respawn:/sbin/getty -L  ttyFIQ0 0 vt100 # GENERIC_SERIAL

# Stuff to do for the 3-finger salute
#::ctrlaltdel:/sbin/reboot

# Stuff to do before rebooting
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
