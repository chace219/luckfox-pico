#!/bin/sh

# Auto-configure and bring up can0 at boot, from the [can_bus] settings in
# /etc/media-gateway/gateway.conf, via the shared /usr/bin/can0-apply.sh.
# The same script is invoked by the web UI on "Save & Apply", so boot-time and
# runtime CAN 2.0B <-> CAN FD switching use one code path.
#
# Set CAN_AUTOCONFIG=0 (env or here) to skip automatic bring-up.
CAN_AUTOCONFIG="${CAN_AUTOCONFIG:-1}"
CAN_IFACE="${CAN_IFACE:-can0}"
CAN_APPLY="/usr/bin/can0-apply.sh"
MAX_WAIT_SECS=10

wait_for_iface() {
	count=0
	while [ ! -d "/sys/class/net/${CAN_IFACE}" ] && [ "$count" -lt "$MAX_WAIT_SECS" ]; do
		sleep 1
		count=$((count + 1))
	done

	[ -d "/sys/class/net/${CAN_IFACE}" ]
}

start() {
	if [ "$CAN_AUTOCONFIG" != "1" ]; then
		echo "CAN boot config skipped: auto bring-up of ${CAN_IFACE} disabled (set CAN_AUTOCONFIG=1 to enable)"
		return 0
	fi

	if [ ! -x "$CAN_APPLY" ]; then
		echo "CAN boot config skipped: ${CAN_APPLY} not found"
		return 0
	fi

	if ! wait_for_iface; then
		echo "CAN boot config skipped: ${CAN_IFACE} did not appear"
		return 0
	fi

	CAN_IFACE="$CAN_IFACE" "$CAN_APPLY"
	return $?
}

stop() {
	[ -d "/sys/class/net/${CAN_IFACE}" ] && ip link set "${CAN_IFACE}" down >/dev/null 2>&1
	return 0
}

restart() {
	stop
	start
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		restart
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
	esac

exit $?
